NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Secondary Supabase project used by the dummy mobile app. These are consumed
# only by server routes in the admin portal.
SECONDARY_SUPABASE_URL=https://<secondary-project-ref>.supabase.co
SECONDARY_SUPABASE_ANON_KEY=<secondary-anon-key>

# Socket.io deployment URL. Do not point this to the admin portal deployment.
NEXT_PUBLIC_SOCKET_URL=https://<socket-service>.up.railway.app

# Server-only
RESEND_API_KEY=re_xxx

# NVIDIA NIM (server only). Keep the key in .secrets/nvidia-api-key.txt locally.
# For deployment, set NVIDIA_API_KEY in the hosting provider's server environment.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Server-only. Needed for admin provisioning, the Active Chats admin-name lookup,
# and scripts/seed-active-chats.ts.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
